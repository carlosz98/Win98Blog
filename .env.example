# DevFeed shared storage (Firebase). Copy to .env.local and fill in from
# Firebase console > Project settings > Your apps > Web app config.
# Leave empty to keep posts in this browser's localStorage only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The Google account allowed to post (must match firestore.rules)
VITE_DEVFEED_ADMIN_EMAIL=
