rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The only Google account allowed to post.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'drewar28@gmail.com';
    }

    match /devfeed_posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Visitors may only like/unlike (one step at a time) or add one comment.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy', 'comments'])
        && request.resource.data.likedBy.size() - resource.data.likedBy.size() in [-1, 0, 1]
        && request.resource.data.likes - resource.data.likes in [-1, 0, 1]
        && request.resource.data.comments.size() - resource.data.comments.size() in [0, 1]
      );
    }

    // Guestbook: anyone can read and sign; only the admin can delete.
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Visitor counter: anyone can read it or add exactly one.
    match /stats/visitors {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Scrapbook: anyone can read; only the admin can post or delete.
    match /scrapbook/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'src', 'caption', 'tag', 'createdAt'])
        && request.resource.data.kind in ['image', 'video', 'youtube', 'text']
        && request.resource.data.src is string && request.resource.data.src.size() <= 900000
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Paint gallery: anyone can read and post a small PNG; only the admin can delete.
    match /gallery/{pictureId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'image', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 150000
        && request.resource.data.image.matches('^data:image/png;base64,.+')
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Visitor map: one counter per two-letter country code, each visit adds one.
    match /visitor_countries/{code} {
      allow read: if true;
      allow create: if code.matches('^[A-Z]{2}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }
  }
}
